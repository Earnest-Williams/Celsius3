<?xml version="1.0" encoding="utf-8" ?>

<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Odyssey</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>

                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/TerrainDef[defName="ShallowFloodwater"]</xpath>
                    <value>
                        <li Class="Celsius.TerrainThermalProperties">
                            <heatCapacity>100</heatCapacity>
                            <insulation>5</insulation>
                            <phaseTransition>None</phaseTransition>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/TerrainDef[defName="MarshFlood"]</xpath>
                    <value>
                        <li Class="Celsius.TerrainThermalProperties">
                            <heatCapacity>100</heatCapacity>
                            <insulation>5</insulation>
                            <phaseTransition>None</phaseTransition>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/TerrainDef[defName="ToxicWaterDeep"]</xpath>
                    <value>
                        <li Class="Celsius.TerrainThermalProperties">
                            <heatCapacity>132</heatCapacity>
                            <insulation>4.5</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/TerrainDef[defName="ToxicWaterOceanDeep"]</xpath>
                    <value>
                        <li Class="Celsius.TerrainThermalProperties">
                            <heatCapacity>121</heatCapacity>
                            <insulation>4.5</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/TerrainDef[defName="ToxicWaterMovingChestDeep"]</xpath>
                    <value>
                        <li Class="Celsius.TerrainThermalProperties">
                            <heatCapacity>198</heatCapacity>
                            <insulation>4.5</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/TerrainDef[defName="ToxicWaterShallow"]</xpath>
                    <value>
                        <li Class="Celsius.TerrainThermalProperties">
                            <heatCapacity>121</heatCapacity>
                            <insulation>4.5</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/TerrainDef[defName="ToxicWaterOceanShallow"]</xpath>
                    <value>
                        <li Class="Celsius.TerrainThermalProperties">
                            <heatCapacity>110</heatCapacity>
                            <insulation>4.5</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/TerrainDef[defName="ToxicWaterMovingShallow"]</xpath>
                    <value>
                        <li Class="Celsius.TerrainThermalProperties">
                            <heatCapacity>165</heatCapacity>
                            <insulation>4.5</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/TerrainDef[defName="HotSpring"]</xpath>
                    <value>
                        <li Class="Celsius.TerrainThermalProperties">
                            <heatCapacity>150</heatCapacity>
                            <insulation>6</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/TerrainDef[defName="LavaDeep"]</xpath>
                    <value>
                        <li Class="Celsius.TerrainThermalProperties">
                            <heatCapacity>1000</heatCapacity>
                            <insulation>10</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/ThingDef[defName="Obsidian"]</xpath>
                    <value>
                        <li Class="Celsius.StuffThermalProperties">
                            <volumetricHeatCapacity>500</volumetricHeatCapacity>
                            <insulationFactor>1</insulationFactor>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/ThingDef[defName="BlocksVacstone"]</xpath>
                    <value>
                        <li Class="Celsius.StuffThermalProperties">
                            <volumetricHeatCapacity>1100</volumetricHeatCapacity>
                            <insulationFactor>.8</insulationFactor>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/ThingDef[defName="SmallThruster"]</xpath>
                    <value>
                        <li Class="Celsius.ThingThermalProperties">
                            <heatCapacity>6</heatCapacity>
                            <insulation>4</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/ThingDef[defName="LargeThruster"]</xpath>
                    <value>
                        <li Class="Celsius.ThingThermalProperties">
                            <heatCapacity>6</heatCapacity>
                            <insulation>4</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/ThingDef[defName="VacBarrier"]</xpath>
                    <value>
                        <li Class="Celsius.ThingThermalProperties">
                            <heatCapacity>3</heatCapacity>
                            <insulation>2</insulation>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/ThingDef[defName="AncientBlastDoor"]</xpath>
                    <value>
                        <li Class="Celsius.ThingThermalProperties">
                            <heatCapacity>5</heatCapacity>
                            <insulation>5</insulation>
                            <airflowWhenOpen>0.75</airflowWhenOpen>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>Defs/ThingDef[defName="BurrowWall"]</xpath>
                    <value>
                        <li Class="Celsius.ThingThermalProperties">
                            <heatCapacity>5</heatCapacity>
                            <insulation>3</insulation>
                            <airflow>0.2</airflow>
                        </li>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
